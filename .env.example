VITE_SUPABASE_URL=https://your-project.supabase.co
# Prefer the legacy anon public JWT with supabase-js.
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Optional newer publishable key (sb_publishable_...)
# VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Local dev: Vite proxies /api/* to this origin (OSM course search, holes, weather).
# Default in vite.config.ts is https://tee-ready.vercel.app — set `none` to disable.
# DEV_API_PROXY=https://tee-ready.vercel.app
