# Client (Vite) — required for auth / profile sync
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Alias also accepted by the client:
# VITE_SUPABASE_PUBLISHABLE_KEY=

# Dev API proxy (vite). Default when unset: https://tee-ready.vercel.app
# DEV_API_PROXY=http://127.0.0.1:3000
# DEV_API_PROXY=none

# Optional CDN overrides (default: same-origin /golf/*)
# VITE_HOLES_BASE_URL=/golf/holes
# VITE_GREENS_BASE_URL=/golf/greens

# Optional swing / round caddie LLM
# Browser on the live HTTPS site uses same-origin POST /api/caddy (never localhost).
# Server: Vercel AI Gateway (OIDC / AI_GATEWAY_API_KEY) or Groq.
# CADDY_LLM_URL=https://ai-gateway.vercel.sh/v1
# CADDY_LLM_MODEL=meta/llama-3.2-3b
# CADDY_LLM_API_KEY=
# GROQ_API_KEY=
# AI_GATEWAY_API_KEY=

# Local LM Studio (npm run dev only): /llm → SWING_LLM_PROXY
# SWING_LLM_PROXY=http://127.0.0.1:1234
# VITE_SWING_LLM_URL=/llm/v1
# VITE_SWING_LLM_MODEL=llama-3.2-11b-vision-instruct
# VITE_SWING_LLM_DISABLED=1

# Optional deep-link origin for weather handoff
# VITE_WEATHER_ORIGIN=

# Server / edge env (never prefix secrets with VITE_)

# Identifying User-Agent for NWS + MET Norway (required by both APIs).
# Example: TeeReady/1.0 (https://tee-ready.vercel.app; you@example.com)
NWS_USER_AGENT=

# Optional override for MET Norway only; falls back to NWS_USER_AGENT.
METNO_USER_AGENT=

# Comma-separated weather providers. Default: nws,metno
# Open-Meteo is only used when listed AND OPEN_METEO_ENABLED=true.
WEATHER_PROVIDERS=nws,metno

# Set to true to re-enable Open-Meteo (non-commercial free tier — keep off for production).
OPEN_METEO_ENABLED=false
