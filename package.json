{
  "name": "teeready",
  "private": true,
  "version": "0.1.0",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "vercel dev --listen 3000",
    "dev:offline": "DEV_API_PROXY=none vite",
    "ollama:serve": "PATH=\"$HOME/.local/ollama:$HOME/.local/bin:$PATH\" ollama serve",
    "ollama:pull": "PATH=\"$HOME/.local/ollama:$HOME/.local/bin:$PATH\" ollama pull llama3.2",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "verify:swing-coach": "tsx scripts/verify-swing-coach-validator.ts",
    "verify:caddy": "tsx scripts/verify-caddy-validator.ts",
    "smoke:caddy-llm": "tsx scripts/smoke-caddy-llm.ts",
    "test:swing-plan": "tsx scripts/test-swing-plan.ts",
    "verify:swing-guide": "tsx scripts/verify-swing-guide-validator.ts",
    "verify:swing-guide-fallback": "tsx scripts/verify-swing-guide-fallback.ts",
    "verify:launch-physics": "tsx scripts/verify-launch-physics.ts",
    "test:launch-simulation": "tsx scripts/test-launch-simulation.ts",
    "test:range": "tsx scripts/test-range.ts",
    "audit:golf-scorecards": "tsx src/dev/golfScorecardAudit.ts",
    "audit:golf-coverage": "tsx src/dev/golfScorecardCoverage.ts",
    "audit:golf-catalog": "tsx src/dev/golfCatalogAudit.ts",
    "audit:course-data": "node scripts/audit-course-data.mjs",
    "audit:geo-accuracy": "tsx scripts/audit-geo-accuracy.ts",
    "test:geo-accuracy": "tsx scripts/test-geo-accuracy.ts",
    "import:golf-scorecards": "node scripts/import-opengolf-scorecards.mjs",
    "build:golf-catalog": "node scripts/build-golf-catalog.mjs",
    "build:world-catalog": "node scripts/build-world-catalog.mjs",
    "build:green-meshes": "node scripts/build-green-meshes.mjs",
    "build:course-assets": "node scripts/build-course-asset-packs.mjs",
    "build:course-assets:manifest": "node scripts/build-course-asset-packs.mjs --manifest-only",
    "backup:osm": "node --import tsx scripts/backup-osm-data.mjs",
    "backup:osm:skip": "node --import tsx scripts/backup-osm-data.mjs --skip-existing",
    "derive:holes": "tsx scripts/derive-holes-from-osm.ts",
    "derive:holes:cleanup": "tsx scripts/derive-holes-from-osm.ts --cleanup-artifacts",
    "test:course-assets": "tsx scripts/batch-test-holes.ts",
    "smoke": "node scripts/smoke-mobile.mjs",
    "test:mobile": "node scripts/mobile-audit.mjs",
    "audit:contrast": "node scripts/contrast-audit.mjs",
    "prebuild": "npm run build:course-directory && node scripts/contrast-audit.mjs",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.mjs",
    "check": "npm run typecheck && npm test && npm run verify:caddy && npm run verify:swing-coach && npm run verify:swing-guide && npm run verify:swing-guide-fallback && npm run test:swing-plan && npm run test:launch-simulation && npm run test:range",
    "test:browser": "node scripts/test-browser.mjs",
    "test:mobile-performance": "node scripts/test-mobile-performance.mjs",
    "build:course-directory": "node scripts/build-course-directory.mjs",
    "test:course-lists": "node scripts/test-course-lists.mjs",
    "test:map-loading": "node scripts/test-map-loading.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "@supabase/supabase-js": "^2.112.3",
    "lucide-react": "^0.469.0",
    "maplibre-gl": "^6.10.0",
    "motion": "^13.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "swr": "^2.2.5",
    "three": "^0.172.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.62.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2",
    "vite": "^6.4.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
